.hud {
    position: absolute;

    top: 20px;
    left: 20px;

    width: 280px;

    padding: 12px;

    background-color: rgba(18, 27, 16, 0.92);

    border-width: 2px;
    border-color: #596052;

    color: #d7dfd0;
}

.debt-board {
    width: 100%;
    height: 100%;

    padding: 14px;

    background-color: #292c27;

    border-width: 4px;
    border-color: #596052;

    color: #d7dfd0;
}

.board-title {
    font-size: 24px;

    color: #e27969;

    -unity-font-style: bold;
    -unity-text-align: middle-center;

    margin-bottom: 12px;
}

.display {
    flex-grow: 1;

    padding: 14px;

    background-color: #121b10;

    border-width: 3px;
    border-color: #56634c;
}

.caption {
    font-size: 15px;
    color: #9ba794;
}

.centered {
    -unity-text-align: middle-center;
}

.balance {
    font-size: 32px;

    color: #b5ec91;

    -unity-font-style: bold;
}

.debt-value {
    font-size: 48px;

    color: #e27969;

    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.line {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;

    margin-top: 4px;
    margin-bottom: 4px;
}

.value {
    font-size: 18px;
    color: #b5ec91;
}

.separator {
    height: 1px;

    background-color: #394d32;

    margin-top: 8px;
    margin-bottom: 8px;
}

.progress-track {
    height: 8px;

    background-color: #303b28;

    margin-top: 6px;

    overflow: hidden;
}

.debt-track {
    height: 16px;

    margin-top: 12px;
}

.progress-fill {
    width: 0%;
    height: 100%;

    background-color: #b5ec91;
}

.percentage {
    font-size: 18px;

    color: #b5ec91;

    -unity-text-align: middle-center;
}

.footer {
    font-size: 14px;

    color: #88937f;

    margin-top: 10px;

    -unity-text-align: middle-center;
}

.offer-timer {
    font-size: 18px;
    color: #e27969;
    -unity-font-style: bold;
}

.offer-fill {
    background-color: #e27969;
}

.purchase-status {
    margin-top: 10px;
    padding: 10px;

    background-color: #776039;

    border-width: 2px;
    border-color: #a28b5c;

    font-size: 20px;
    color: #ead8b3;

    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.purchase-unavailable {
    background-color: #443633;
    color: #e27969;
}

.boost-banner {
    display: none;
    margin-top: 12px;
}

.boost-active {
    display: flex;
}

.boost-label {
    font-size: 18px;
    color: #e5ca7d;
    -unity-font-style: bold;
}

.boost-fill {
    background-color: #e5ca7d;
}